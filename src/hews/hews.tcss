Screen {
    layout: vertical;
}

#status {
    dock: top;
    width: 100%;
    padding: 0 1;
    height: 1;
    background: $surface;
    color: $text;
}

#startup-banner {
    dock: top;
    width: 100%;
    height: auto;
    padding: 1 2 0 2;
    background: $surface;
    content-align: center middle;
    text-wrap: nowrap;
}

#stories {
    width: 100%;
    height: 1fr;
}

StoryListItem {
    width: 100%;
    height: auto;
    min-height: 3;
    padding: 0 1;
}

StoryListItem > .story-title,
StoryListItem > .story-meta {
    width: 100%;
}

StoryListItem > .story-title {
    text-style: bold;
    color: $accent;
}

StoryListItem > .story-meta {
    color: $text-muted;
}

StoryListItem.-highlight {
    background: $accent;
}

StoryListItem.-highlight > .story-title,
StoryListItem.-highlight > .story-meta {
    color: $text;
}

#story-header {
    width: 100%;
    padding: 1 2;
    text-style: bold;
    color: $accent;
}

#story-text {
    width: 100%;
    padding: 0 2;
    height: auto;
}

#comments-status {
    width: 100%;
    padding: 0 2;
    color: $text-muted;
}

#comments {
    width: 100%;
    height: 1fr;
}

CommentListItem {
    width: 100%;
    height: auto;
    min-height: 3;
    padding: 0 1;
}

CommentListItem > .comment-meta,
CommentListItem > .comment-body {
    width: 100%;
}

CommentListItem > .comment-meta {
    color: $text-muted;
}

CommentListItem > .comment-body {
    color: $text;
}

CommentListItem.-highlight {
    background: $accent;
}

CommentListItem.-highlight > .comment-meta,
CommentListItem.-highlight > .comment-body {
    color: $text;
}

SearchDialog {
    align: center middle;
    background: $background 60%;
}

ReplyDialog {
    align: center middle;
    background: $background 60%;
}

HelpScreen {
    align: center middle;
    background: $background 70%;
}

#help-content {
    width: 86;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    color: $text;
    border: round $accent;
}

#search-title {
    width: 60;
    padding: 1 2 0 2;
    background: $surface;
    color: $accent;
    text-style: bold;
}

#reply-title {
    width: 70;
    padding: 1 2 0 2;
    background: $surface;
    color: $accent;
    text-style: bold;
}

#search-query {
    width: 60;
    padding: 0 2 1 2;
    background: $surface;
}

#reply-text {
    width: 70;
    padding: 0 2 1 2;
    background: $surface;
}
