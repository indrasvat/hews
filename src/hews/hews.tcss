Screen {
    layout: vertical;
}

#status {
    dock: top;
    padding: 0 1;
    height: 1;
    background: $surface;
    color: $text;
}

#startup-banner {
    dock: top;
    height: auto;
    padding: 1 2 0 2;
    background: $surface;
    content-align: center middle;
    text-wrap: nowrap;
}

#stories {
    height: 1fr;
}

StoryListItem {
    height: auto;
    min-height: 3;
    padding: 0 1;
}

StoryListItem > .story-title {
    text-style: bold;
    color: $accent;
}

StoryListItem > .story-meta {
    color: $text-muted;
}

StoryListItem.-highlight {
    background: $accent;
}

StoryListItem.-highlight > .story-title,
StoryListItem.-highlight > .story-meta {
    color: $text;
}

#story-header {
    padding: 1 2;
    text-style: bold;
    color: $accent;
}

#story-text {
    padding: 0 2;
    height: auto;
}

#comments-status {
    padding: 0 2;
    color: $text-muted;
}

#comments {
    height: 1fr;
}

CommentListItem {
    height: auto;
    min-height: 3;
    padding: 0 1;
}

CommentListItem > .comment-meta {
    color: $text-muted;
}

CommentListItem > .comment-body {
    color: $text;
}

CommentListItem.-highlight {
    background: $accent;
}

CommentListItem.-highlight > .comment-meta,
CommentListItem.-highlight > .comment-body {
    color: $text;
}

SearchDialog {
    align: center middle;
    background: $background 60%;
}

ReplyDialog {
    align: center middle;
    background: $background 60%;
}

HelpScreen {
    align: center middle;
    background: $background 70%;
}

#help-content {
    width: 86;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    color: $text;
    border: round $accent;
}

#search-title {
    width: 60;
    padding: 1 2 0 2;
    background: $surface;
    color: $accent;
    text-style: bold;
}

#reply-title {
    width: 70;
    padding: 1 2 0 2;
    background: $surface;
    color: $accent;
    text-style: bold;
}

#search-query {
    width: 60;
    padding: 0 2 1 2;
    background: $surface;
}

#reply-text {
    width: 70;
    padding: 0 2 1 2;
    background: $surface;
}

StatsScreen {
    background: #151b28;
    padding: 1 2;
    align: center middle;
}

#stats-frame {
    width: 100%;
    max-width: 110;
    height: 100%;
    border: solid #7a8ba8;
    background: #1b2333;
}

#stats-header {
    height: 3;
    border-bottom: solid #7a8ba8;
}

#stats-dots, #stats-header-spacer {
    width: 9;
    height: 2;
    content-align: center middle;
    color: #7a8ba8;
}

#stats-heading {
    width: 1fr;
    height: 2;
    content-align: center middle;
    text-style: italic bold;
    color: #d7dce8;
}

#stats-status {
    height: auto;
    padding: 0 2;
    color: #ff8700;
}

#stats-stories {
    height: 1fr;
    padding: 1 1 0 1;
    background: #1b2333;
    scrollbar-size: 1 1;
}

StatsStoryItem {
    height: 3;
    padding: 0 1;
    background: #1b2333;
}

StatsStoryItem.-highlight {
    background: #28354b;
}

StatsChart {
    height: 2;
}

#stats-footer {
    height: 2;
    border-top: solid #7a8ba8;
    padding: 0 2;
    color: #d7dce8;
}
